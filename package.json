  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:ui": "tsx --tsconfig tsconfig.test.json tests/brand-directory.ui.tsx && tsx --tsconfig tsconfig.test.json tests/contact-form.ui.tsx && tsx --tsconfig tsconfig.test.json tests/news-directory.ui.tsx && tsx --tsconfig tsconfig.test.json tests/faq-directory.ui.tsx && tsx --tsconfig tsconfig.test.json tests/search-dialog.ui.tsx && tsx --tsconfig tsconfig.test.json tests/analytics-consent.ui.tsx",
    "test": "npm run test:unit && npm run test:ui",
    "audit:site": "node scripts/audit-site.mjs"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.1.0",
    "git": "^0.1.5",
    "init": "^0.1.2",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.14.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
